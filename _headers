# Cloudflare Pages cache rules.
#
# Photos, CSS and JS get a one-day browser cache, then a week where the browser
# shows the cached copy instantly while it quietly checks for a new one. That
# makes repeat visits fast WITHOUT the usual trap: if you replace a photo and
# keep the same filename, everyone picks up the new one within a day.
#
# (The usual advice here is "cache for a year". Don't — that would leave people
# looking at last year's gear photos long after you swapped them.)
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# config.js is the file you edit most, so it is never cached — edits go live at once.
/config.js
  Cache-Control: public, max-age=0, must-revalidate
